# OpenSeaBri Core — required
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenSeaBri Core — UI
VITE_SEABRIDGE_API_URL=http://localhost:8000

# SeaBridgeAI Backend Integration — optional, enables quantitative data
SEABRIDGE_API_URL=http://localhost:8000
SEABRIDGE_API_KEY=your_seabridge_api_key_here

# Communication channels — all optional
TELEGRAM_TOKEN=your_telegram_bot_token
DISCORD_TOKEN=your_discord_bot_token

# Research loop — optional, enables web search
TAVILY_API_KEY=your_tavily_key_here

# Gateway
GATEWAY_PORT=18790
