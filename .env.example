# OpenSeaBri Core — gateway required for streaming chat
# VITE_ANTHROPIC_API_KEY is removed — direct browser LLM calls are disabled.
# All LLM streaming routes through the backend gateway via WebSocket.
VITE_GATEWAY_URL=http://localhost:8000
VITE_OPENSEABRI_API_KEY=your_openseabri_gateway_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Communication channels — all optional
# Credentials alone do not start live channels. To intentionally enable one,
# set OPENSEABRI_CHANNELS_ENABLED after live-provider approval.
OPENSEABRI_CHANNELS_ENABLED=
TELEGRAM_TOKEN=your_telegram_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Research loop — optional, enables web search
TAVILY_API_KEY=your_tavily_key_here

# Web ingestion is executed by the SeaBridgeAI backend proxy.
# Set these in manageesg-backend when you want Firecrawl enabled.
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=

# Document execution / e-signature is executed by the SeaBridgeAI backend proxy.
# Live send requires a backend approval token; helpers default to dry-run.
OPENSEABRI_DOCUMENT_EXECUTION_ENABLED=false

# Physical risk models — optional, enriches wildfire assessments
# NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_KEY=your_nasa_firms_key_here
# AirNow: https://docs.airnowapi.org/account/request/
AIRNOW_KEY=your_airnow_key_here

# Gateway
GATEWAY_PORT=18790
VITE_GATEWAY_URL=http://localhost:18790
# WebSocket auth token — when SEABRI_WS_TOKEN is set on the gateway, the frontend must
# send the same value as VITE_WS_TOKEN so the browser WebSocket passes authentication.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEABRI_WS_TOKEN=
VITE_WS_TOKEN=

# Cron preset security — required to enable scheduled compliance briefings
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENSEABRI_RUN_SECRET=

# Gateway HTTP API auth — required for /api/seabri/* in staging/production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENSEABRI_API_KEY=

# Backend bridge approval secrets belong ONLY in manageesg-backend/.env, NOT here.
# OPENSEABRI_RUN_APPROVAL_SECRET=  (set on the backend, not here)

# Canvas WebSocket (A2UI / Live Canvas) — optional
# When OPENSEABRI_CANVAS_WS_PORT is unset, the WS hub is a no-op.
OPENSEABRI_CANVAS_WS_PORT=18791
VITE_CANVAS_WS_URL=ws://localhost:18791

# SMS / Outbound Calls (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567
# TwiML endpoint base URL — set to your publicly reachable gateway URL (e.g. https://seabri.example.com)
# The gateway serves GET /twiml?message=<encoded> internally; set this to its public origin.
TWILIO_VOICE_TWIML_BASE_URL=https://your-gateway-domain.example.com
# Set to true to enable AI-initiated outbound calls after user approval
OUTBOUND_CALLS_ENABLED=false

# Granular outbound action gates (these override OUTBOUND_CALLS_ENABLED)
# SEABRI_CALLS_ENABLED — allow SeaBri to initiate voice calls after YES CALL approval
SEABRI_CALLS_ENABLED=false
# SEABRI_CALL_TEST_MODE — restrict calls to whitelisted numbers only (dev/staging)
SEABRI_CALL_TEST_MODE=false
# SEABRI_CALL_TEST_ALLOWED_NUMBERS — comma-separated digit-only numbers for test mode
SEABRI_CALL_TEST_ALLOWED_NUMBERS=<your-test-phone-number>
# SEABRI_MESSAGES_ENABLED — allow SeaBri to send SMS after YES SEND / YES TEXT approval
SEABRI_MESSAGES_ENABLED=false
# SEABRI_MESSAGE_TEST_MODE — restrict SMS to whitelisted numbers in SEABRI_CALL_TEST_ALLOWED_NUMBERS
SEABRI_MESSAGE_TEST_MODE=false

# Live provider validation gate. Keep false unless an approved staging live-provider smoke is running.
OPENSEABRI_LIVE_PROVIDER_TESTS_ENABLED=false
OPENSEABRI_PROVIDER_TEST_MODE=true

# Approval TTL — how long (ms) a pending action card waits for YES/NO before expiring (default: 300000 = 5 min)
OPENSEABRI_APPROVAL_TTL_MS=300000

# Shared local 9Router. Use AI_ROUTER_API_KEY from the 9Router dashboard/API keys.
AI_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
AI_ROUTER_API_KEY=
ANTHROPIC_BASE_URL=http://127.0.0.1:20128/v1
OPENSEABRI_MODEL=seabridge-one-router

OPENAI_API_KEY=your_openai_key_here # for Whisper audio/video transcription

# Emergency SMS — requires Twilio credentials above
# Set EMERGENCY_SMS_ENABLED=true to allow the notify_emergency executor to fire
EMERGENCY_SMS_ENABLED=false
EMERGENCY_ALERT_NUMBER=+15559876543

# Database column encryption — required for PII protection at rest (SEC-010).
# Encrypts messages.tool_input_enc and workflows.trigger_config_enc columns.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex chars (32 bytes). Never commit this value.
OPENSEABRI_DB_ENCRYPTION_KEY=

# Email webhook secret — required to secure the SendGrid Inbound Parse webhook endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENSEABRI_EMAIL_WEBHOOK_SECRET=
# WARNING: This secret is passed as ?token= in the webhook URL and will appear
# in web server access logs. Scrub logs in production or switch to a header-based
# verification scheme before handling high-volume email webhooks.

# Email (send_email executor) — configure one provider
# SendGrid (preferred)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SMTP fallback (used when SENDGRID_API_KEY is not set; requires nodemailer: npm i nodemailer)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── vLLM — self-hosted OpenAI-compatible inference ────────────────────────────
# INACTIVE by default. Requires a GPU server running vLLM; see manageesg-backend
# .env.example for the Docker quickstart and cost-break-even guidance.
#
# How it works: set OPENAI_API_BASE to redirect any openai-client call to a
# local vLLM server (vLLM exposes the same /v1/chat/completions interface).
# The existing OPENAI_API_KEY in this file is accepted as-is by vLLM (any
# non-empty string is valid).
#
# Use case in openseabri: supplementary tasks that currently use the openai
# package (Whisper transcription excluded — that requires OpenAI servers).
#
# Activation: uncomment OPENAI_API_BASE and point it at the vLLM host.
# Feature gate — flip to true only after the vLLM server is verified healthy.
VLLM_ENABLED=false
# OPENAI_API_BASE=http://localhost:8000/v1

# Persistent telemetry foundation. Default is in-memory only.
# Set OPENSEABRI_TELEMETRY_STORE=file only after choosing a writable staging path.
OPENSEABRI_TELEMETRY_STORE=memory
# OPENSEABRI_TELEMETRY_PATH=data/openseabri/telemetry/events.jsonl
