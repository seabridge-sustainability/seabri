# OpenSeaBri staging environment template
# Copy into the staging provider secret store. Do not commit real values.

# Runtime mode
NODE_ENV=production
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=18790

# Required HTTP API auth for /api/seabri/*
# Generate unique staging value:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENSEABRI_API_KEY=<staging-random-api-key>

# Required gateway WebSocket auth
SEABRI_WS_TOKEN=<staging-random-ws-token>

# Browser/frontend configuration
OPENSEABRI_CORS_ORIGIN=<https://staging-openseabri.example.com>
OPENSEABRI_RATE_LIMIT=120

# Canvas WebSocket
# Leave OPENSEABRI_CANVAS_WS_PORT unset to disable canvas WS.
# If enabled, OPENSEABRI_CANVAS_WS_TOKEN is required.
OPENSEABRI_CANVAS_WS_PORT=
OPENSEABRI_CANVAS_WS_TOKEN=<staging-random-canvas-token-if-enabled>

# Telemetry
# Default: in-memory only. For staging file telemetry, set:
# OPENSEABRI_TELEMETRY_STORE=file
# OPENSEABRI_TELEMETRY_PATH=<writable-provider-volume>/openseabri/telemetry/events.jsonl
OPENSEABRI_TELEMETRY_STORE=memory
OPENSEABRI_TELEMETRY_PATH=

# Live provider gates
# These must remain false until an approved live-provider validation run.
OPENSEABRI_LIVE_PROVIDER_TESTS_ENABLED=false
OPENSEABRI_PROVIDER_TEST_MODE=true
OPENSEABRI_LLM_LIVE_MODE=false
OPENSEABRI_MCP_LIVE_MODE=false
OPENSEABRI_STORAGE_LIVE_MODE=false

# Channel enablement
# Keep empty for first staging deploy. Add only approved test channels later.
OPENSEABRI_CHANNELS_ENABLED=

# Outbound SMS/call gates
# Keep disabled unless a staging live-provider test has been approved.
SEABRI_MESSAGES_ENABLED=false
SEABRI_MESSAGE_TEST_MODE=true
SEABRI_CALLS_ENABLED=false
SEABRI_CALL_TEST_MODE=true
OUTBOUND_CALLS_ENABLED=false

# Allowed test contacts
# Digit-only values. Never include customers or third parties without approval.
SEABRI_CALL_TEST_ALLOWED_NUMBERS=<approved-test-number-digits-only>
OPENSEABRI_INBOUND_PHONE_ALLOWLIST=

# Optional Telegram test bot. Leave unset before live validation approval.
TELEGRAM_TOKEN=

# Optional WhatsApp Cloud test/sandbox credentials. Leave unset before approval.
WHATSAPP_PROVIDER=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional Twilio test credentials. Leave unset before approval.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_SECRET=
TWILIO_WEBHOOK_URL=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_TWIML_BASE_URL=

# Optional LLM providers. Paid/live keys require approval.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LOCAL_INFERENCE_URL=

# Optional backend bridge / storage. Configure only if staging requires it.
SEABRIDGE_API_URL=
SEABRIDGE_API_KEY=
OPENSEABRI_STORAGE_URL=
DATABASE_URL=
REDIS_URL=

# Staging smoke client settings
# Set these on the operator machine when running npm run smoke:staging.
OPENSEABRI_STAGING_ORIGIN=<https://staging-gateway.example.com>
OPENSEABRI_STAGING_WS_URL=<wss://staging-gateway.example.com>
OPENSEABRI_STAGING_CANVAS_WS_URL=

