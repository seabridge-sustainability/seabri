{
  "mcpServers": {
    "berry": {
      "args": [
        "mcp",
        "--server",
        "classic"
      ],
      "command": "berry",
      "env": {
        "BERRY_SERVICE_URL": "http://52.191.234.157:8000",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_BASE_URL": "http://20.232.57.156/v1",
        "STRAWBERRY_SERVICE_URL": "http://52.191.234.157:8000"
      }
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "sequential": true,
        "hooks": [
          {
            "type": "command",
            "name": "SeaBridge MCP Sentinel",
            "command": "python3 \"C:/Users/adelm/SeaBridgeAI/everything-claude-code/scripts/sentinel_preflight_gate.py\"",
            "timeout": 10000,
            "description": "Block suspicious tool calls before Gemini CLI executes them."
          }
        ]
      }
    ]
  }
}

