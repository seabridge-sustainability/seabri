  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "cli",
    "gateway",
    "research",
    "daemon",
    "bridge",
    "integrations",
    "src",
    "skills",
    "types",
    "AGENTS.md",
    "SOUL.md",
    "TOOLS.md",
    "README.md",
    "LICENSE"
