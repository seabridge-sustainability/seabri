{
  "name": "@seabridge/openseabri",
  "version": "1.0.0",
  "private": false,
  "description": "OpenSeaBri - your personal sustainability intelligence system. Free, open source, self-improving. Built on openclaw + hermes-agent + autoresearch concepts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "gateway": "tsx gateway/index.ts",
    "gateway:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-gateway-ports.ps1",
    "gateway:restart": "npm run gateway:stop && npm run gateway",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cli": "tsx cli/seabri.ts",
    "research": "tsx research/overnight.ts",
    "canvas:seed": "tsx scripts/dev-canvas-seed.ts",
    "validate:staging": "tsx scripts/validate-staging.ts",
    "check:production": "tsx scripts/check-production.ts",
    "validate:production": "tsx scripts/validate-production.ts",
    "deployment:preflight": "tsx scripts/deployment-preflight.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:db": "tsx scripts/check-db.ts",
    "db:migration-check": "tsx scripts/db-migration-check.ts",
    "check:operational-readiness": "tsx scripts/check-operational-readiness.ts",
    "owner:next": "tsx scripts/owner-next-steps.ts",
    "check:operational": "tsx scripts/operational-smoke.ts",
    "release:check": "tsx scripts/release-check.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "approve:provider": "tsx scripts/approve-provider.ts",
    "smoke:staging": "tsx scripts/staging-smoke.ts",
    "smoke:demos": "tsx scripts/demo-smoke.ts",
    "smoke:pilot": "tsx scripts/pilot-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:node": "tsx --test tests/*.test.mts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@langchain/anthropic": "^1.3.28",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.2.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.16.0",
    "better-auth": "^1.6.9",
    "better-sqlite3": "^11.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fluent-ffmpeg": "^2.1.3",
    "inquirer": "^13.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.447.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.35.0",
    "ora": "^8.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "twilio": "^6.0.0",
    "uuid": "^14.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
