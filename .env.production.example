# OpenSeaBri production secret-manager template.
# Copy labels into the selected host secret manager. Do not paste real secrets
# into chat, docs, git, screenshots, or support tickets.

# Deployment identity
OPENSEABRI_MODE=production
OPENSEABRI_HOSTING_TARGET=godaddy-dns-docker-host
OPENSEABRI_PUBLIC_ORIGIN=https://app.<your-domain>
OPENSEABRI_GATEWAY_ORIGIN=https://api.<your-domain>
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=18790

# Required gateway/API auth
OPENSEABRI_API_KEY=<set-in-secret-manager>
SEABRI_WS_TOKEN=<set-in-secret-manager>
OPENSEABRI_CORS_ORIGIN=https://app.<your-domain>
OPENSEABRI_RATE_LIMIT=120

# Required production persistence
OPENSEABRI_PERSISTENCE_ADAPTER=database
SEABRI_DATABASE_URL=<set-in-secret-manager>
# Optional alias supported by the runtime if the host provides DATABASE_URL.
# Prefer SEABRI_DATABASE_URL when both are available.
DATABASE_URL=

# Required production telemetry behavior. Database keeps telemetry, profile,
# session, and provider evidence persistence together for multi-user production.
OPENSEABRI_TELEMETRY_STORE=database
OPENSEABRI_TELEMETRY_PATH=

# Canvas WebSocket: required only if canvas WS is exposed in production.
OPENSEABRI_CANVAS_WS_PORT=18791
OPENSEABRI_CANVAS_WS_TOKEN=<set-in-secret-manager>

# Live providers remain closed for first production launch.
OPENSEABRI_CHANNELS_ENABLED=
OPENSEABRI_LIVE_PROVIDER_APPROVED=false
OPENSEABRI_LIVE_PROVIDER_TESTS_ENABLED=false
OPENSEABRI_PROVIDER_TEST_MODE=true

# Optional providers. Credentials may exist before launch, but providers must
# not be enabled until validation evidence exists and the live gate is approved.
TELEGRAM_TOKEN=
WHATSAPP_PROVIDER=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_TWIML_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
ANTHROPIC_BASE_URL=
OPENSEABRI_MODEL=seabridge-one-router
LOCAL_VISION_URL=
TAVILY_API_KEY=

# Optional MCP external tools. Keep blank until each tool is allowlisted and
# smoke-tested with no secret leakage.
OPENSEABRI_MCP_EXTERNAL_TOOLS_ENABLED=false
OPENSEABRI_MCP_EXTERNAL_TOOL_SECRETS=<set-in-secret-manager-if-needed>

# Safe test allowlists
SEABRI_MESSAGE_TEST_MODE=true
SEABRI_CALL_TEST_MODE=true
SEABRI_CALL_TEST_ALLOWED_NUMBERS=<comma-separated-approved-test-numbers>

# DB verification is opt-in so local/CI checks never touch production accidentally.
OPENSEABRI_DB_REQUIRED=true
OPENSEABRI_DB_CONNECT_CHECK=false
